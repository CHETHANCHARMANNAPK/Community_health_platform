# ================================================================
# Firebase Configuration
# ================================================================
# To set up Firebase:
#
# 1. Go to https://console.firebase.google.com/
# 2. Click "Create a project" (or select an existing one)
# 3. Once created, click the gear icon > "Project settings"
# 4. Scroll down to "Your apps" and click the Web icon (</>)
# 5. Register your app with a name (e.g., "HealthCare+")
# 6. Copy the config values below
# 7. Rename this file to .env.local (remove .example)
# 8. Paste your values and restart the dev server
#
# To enable Google Sign-In:
# 1. In Firebase Console, go to Authentication > Sign-in method
# 2. Enable "Google" provider
# 3. Add your domain to "Authorized domains" (localhost is there by default)
#
# To enable Firestore Database:
# 1. In Firebase Console, go to Firestore Database
# 2. Click "Create database"
# 3. Choose "Start in test mode" for development
# ================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
